{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cobalt internal API",
  "colors": {
    "primary": "#5865F2",
    "light": "#7480FF",
    "dark": "#424BB2"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "App integration",
        "pages": [
          "index",
          "quickstart",
          "architecture",
          "route-index"
        ]
      },
      {
        "group": "Accounts",
        "pages": [
          "authentication",
          "browser-auth",
          "profiles"
        ]
      },
      {
        "group": "Social and player data",
        "pages": [
          "social",
          "messages",
          "saves",
          "playtime",
          "minecraft"
        ]
      },
      {
        "group": "Games and administration",
        "pages": [
          "catalog",
          "discovery",
          "admin",
          "api-overview"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Cobalt",
          "href": "https://cobaltlauncher.com",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Cobalt",
        "href": "https://cobaltlauncher.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Cobalt",
      "href": "https://cobaltlauncher.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
