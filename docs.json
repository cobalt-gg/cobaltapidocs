{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cobalt Backend",
  "colors": {
    "primary": "#5865F2",
    "light": "#7480FF",
    "dark": "#424BB2"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
          "architecture"
        ]
      },
      {
        "group": "Build with Cobalt",
        "pages": [
          "api-overview"
        ]
      },
      {
        "group": "Operate Cobalt",
        "pages": [
          "configuration",
          "deployment",
          "plugins"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Cobalt",
          "href": "https://cobaltlauncher.com",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Cobalt",
        "href": "https://cobaltlauncher.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Cobalt",
      "href": "https://cobaltlauncher.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/CobaltLauncher"
    }
  }
}
